# =============================================================================
# MediMitra CareLoop — Environment Configuration Template
# Google Cloud & Firebase Hackathon Setup
# =============================================================================
# Copy this file to .env and replace placeholders with your actual project keys.
# When running without this file, the application functions in local demo mode.

# --- Firebase Web App Configuration ---
# Obtain these values from: Firebase Console -> Project Settings -> General -> Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_google_cloud_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_fcm_sender_id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890

# --- Google Cloud Run Backend API URL ---
# The HTTPS URL of your deployed Cloud Run microservice (e.g., https://medimitra-api-xyz-uc.a.run.app)
# For local server development: http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api

# --- Google Cloud Project Metadata ---
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_REGION=us-central1
